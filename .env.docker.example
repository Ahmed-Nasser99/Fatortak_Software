# ---------------------------------------------------------------------------
# Copy to .env and replace every value before running `docker compose up`.
# Never commit .env.
# ---------------------------------------------------------------------------

# SQL Server (12+ characters, upper + lower + number + symbol)
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Deployment mode: SelfHosted (single installation, no tenant/subscription limits)
# or MultiTenant (SaaS). Docker defaults to SelfHosted.
DEPLOYMENT_MODE=SelfHosted
SELF_HOSTED_ALLOW_REGISTRATION=true

# API
JWT_KEY=replace-with-64-random-characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng!Pass

# Public URL of the API as seen by the browser (used at web build time)
PUBLIC_API_URL=http://localhost:5000

# Public URL of the web app (used in password-reset links and CORS)
PUBLIC_WEB_URL=http://localhost:3000

# Ports exposed on the host
WEB_PORT=3000
API_PORT=5000
DB_PORT=1433

# AI (optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
