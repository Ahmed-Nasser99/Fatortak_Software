    "Port": 587
  },
  "SeedAdmin": {
    "Email": "admin@your-domain.com",
    "UserName": "FatortakAdmin",
    "Password": ""
  },
  "AllowedHosts": "*",
  "GeminiApiKey": "YOUR_GEMINI_API_KEY",
