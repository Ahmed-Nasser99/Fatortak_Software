# Fatortak marketing portal — copy to .env and fill only the channels you have.
# Never commit .env. Tokens are read by the portal server and are never returned by the API.

# Server
PORTAL_HOST=127.0.0.1
PORTAL_PORT=4180
PORTAL_ADMIN_TOKEN=
TZ=Africa/Cairo

# Safety
# Live API publishing is locked unless this is true.
MARKETING_LIVE=false
# The scheduler only runs when this is true, MARKETING_LIVE is true and the portal dry-run setting is off.
PORTAL_AUTO_PUBLISH=false

# X (Twitter) API v2 — OAuth 2.0 user context with tweet.write
X_ACCESS_TOKEN=

# LinkedIn — company page OAuth token with w_organization_social and r_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:XXXXXXXX
LINKEDIN_VERSION=202507

# Bluesky — create an app password in Settings > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# Mastodon
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_ACCOUNT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK_URL=

# Meta / Facebook Page — app review required for pages_manage_posts and read_insights
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business — linked to the Facebook Page; app review required
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Threads — app review required
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Dev.to — Forem API key
DEVTO_API_KEY=

# TikTok — Content Posting API requires an app audit; leave empty until approved
TIKTOK_ACCESS_TOKEN=

# YouTube — OAuth + Analytics API; video-only publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Analytics
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=

# GitHub monitoring (optional; public stats work without a token)
GITHUB_TOKEN=
