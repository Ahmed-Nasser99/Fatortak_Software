# Copy to .env (never commit) and fill only the channels you actually use.
# The system skips a channel when its credentials are missing — it never fails a run for that reason.

# Master switch. Leave false until you have reviewed a dry run.
MARKETING_LIVE=false

# X (Twitter) API v2 — OAuth 2.0 user context with tweet.write
X_ACCESS_TOKEN=

# LinkedIn — w_member_social or w_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
LINKEDIN_VERSION=202507

# Bluesky — create an app password in Settings > App passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# Mastodon
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Telegram / Discord community announcements (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# GitHub — used for growth reports and repo metadata
# GITHUB_TOKEN is provided automatically inside GitHub Actions.
GITHUB_TOKEN=
# Fine-grained PAT with "Administration: write" if you want `npm run repo` to update metadata.
REPO_ADMIN_TOKEN=

# Analytics (optional)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
